{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 24, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "dev",
      "inherits": "base",
      "displayName": "Development (RelWithDebInfo, warnings on)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "SWEEPPP_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "debug",
      "inherits": "base",
      "displayName": "Debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "SWEEPPP_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "release",
      "inherits": "base",
      "displayName": "Release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "SWEEPPP_BUILD_TESTS": "OFF",
        "SWEEPPP_WERROR": "OFF",
        "SWEEPPP_CHANNEL": "release"
      }
    },
    {
      "name": "asan",
      "inherits": "base",
      "displayName": "AddressSanitizer + UBSan (tests)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "SWEEPPP_SANITIZER": "address+undefined",
        "SWEEPPP_BUILD_TESTS": "ON",
        "SWEEPPP_BUILD_GUI": "OFF",
        "SWEEPPP_WITH_WEB_UI": "OFF",
        "SWEEPPP_BUILD_PLUGINS": "ON"
      }
    },
    {
      "name": "tsan",
      "inherits": "base",
      "displayName": "ThreadSanitizer (pipeline)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "SWEEPPP_SANITIZER": "thread",
        "SWEEPPP_BUILD_TESTS": "ON",
        "SWEEPPP_BUILD_GUI": "OFF",
        "SWEEPPP_WITH_WEB_UI": "OFF",
        "SWEEPPP_BUILD_PLUGINS": "ON"
      }
    },
    {
      "name": "headless",
      "inherits": "base",
      "displayName": "Headless node (no GUI) -- for remote sweeppp-cli serve",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "SWEEPPP_BUILD_GUI": "OFF",
        "SWEEPPP_BUILD_TESTS": "OFF"
      }
    }
  ],
  "buildPresets": [
    { "name": "dev",      "configurePreset": "dev" },
    { "name": "debug",    "configurePreset": "debug" },
    { "name": "release",  "configurePreset": "release" },
    { "name": "asan",     "configurePreset": "asan" },
    { "name": "tsan",     "configurePreset": "tsan" },
    { "name": "headless", "configurePreset": "headless" }
  ],
  "testPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "asan",
      "configurePreset": "asan",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "tsan",
      "configurePreset": "tsan",
      "output": { "outputOnFailure": true }
    }
  ]
}
